% For codes
\lstdefinestyle{Cpp}{
    language=C++,                    % Specifies the language
    basicstyle=\ttfamily\footnotesize, % Font size and type
    keywordstyle=\color{blue}\bfseries, % Keywords in bold blue
    commentstyle=\color{green!50!black}\itshape, % Comments in italic green
    stringstyle=\color{red},         % Strings in red
    numberstyle=\tiny\color{gray},   % Line numbers style
    numbers=left,                    % Line numbers on the left
    stepnumber=1,                    % Numbers every line
    numbersep=10pt,                  % Space between line numbers and code
    backgroundcolor=\color{pink!10}, % Light gray background
    frame=single,                    % Adds a frame around the code
    tabsize=4,                       % Sets tab size
    captionpos=b,                    % Caption below the listing
    breaklines=true,                 % Line breaking
    %breakindent=0pt,                 % No indent for broken lines
    breakatwhitespace=false,         % Only break at whitespace if needed
    showspaces=false,                % Don't show spaces
    showtabs=false,                  % Don't show tabs
    showstringspaces=false,          % Don't mark spaces in strings
    %deletekeywords={not},            % Remove 'not' from highlighted keywords
    morekeywords={nullptr, size_t, uint32_t, int32_t, int64_t}, % Custom keywords
}

